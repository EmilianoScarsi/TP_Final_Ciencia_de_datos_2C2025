png(file.path(out_dir, "07_missing_per_variable.png"), width = 1000, height = 600)
print(gg_miss_var(df) + ggtitle("Missing per variable"))
dev.off()
png(file.path(out_dir, "08_missing_matrix.png"), width = 1000, height = 800)
print(vis_miss(df, cluster = TRUE) + ggtitle("Missingness matrix"))
dev.off()
