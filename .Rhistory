library(tidyverse)
library(janitor)
library(skimr)
library(naniar)
library(ggplot2)
library(openxlsx)
# ======= Carpeta de salida corregida =======
out_dir <- "processed/EDA"
dir.create(out_dir, recursive = TRUE, showWarnings = FALSE)
# Si tu objeto no se llama df_final, cambialo aquí
df <- df_final
# ---------- utilidades ----------
moda <- function(x) {
x <- na.omit(x)
if(length(x)==0) return(NA)
ux <- unique(x)
ux[which.max(tabulate(match(x, ux)))]
}
is_date_like <- function(x) {
if(inherits(x, "Date") || inherits(x, "POSIXt")) return(TRUE)
s <- na.omit(as.character(x))
if(length(s) == 0) return(FALSE)
s <- head(s, 50)
parsed <- suppressWarnings(lubridate::parse_date_time(s, orders = c("Ymd","dmy","mdy","ymd HMS","ymd HM")))
sum(!is.na(parsed)) / length(s) > 0.6
}
View(is_date_like)
View(df)
View(df_final)
View(df)
# ---------- 1) Estructura general ----------
structure_txt <- file.path(out_dir, "01_structure.txt")
sink(structure_txt)
cat("=== ESTRUCTURA (str) ===\n\n")
# ---------- 1) Estructura general ----------
structure_txt <- file.path(out_dir, "01_structure.txt")
sink(structure_txt)
cat("=== ESTRUCTURA (str) ===\n\n")
str(df)
cat("\n\n=== DIMENSIONES ===\n")
cat("Filas:", nrow(df), " Columnas:", ncol(df), "\n\n")
cat("=== NOMBRE DE COLUMNAS ===\n")
print(names(df))
sink()
message("Dimensiones: ", nrow(df), " filas x ", ncol(df), " columnas")
# ---------- 2) Tipos de datos, n_unicos, NAs, fechas ----------
var_info <- tibble(
variable = names(df),
class = sapply(df, function(x) paste(class(x), collapse = ", ")),
n_unique = sapply(df, function(x) length(unique(x))),
n_na = sapply(df, function(x) sum(is.na(x))),
pct_na = round(100 * sapply(df, function(x) mean(is.na(x))), 2),
is_numeric = sapply(df, is.numeric),
is_character = sapply(df, is.character),
is_factor = sapply(df, is.factor),
is_date_like = sapply(df, is_date_like)
)
View(var_info)
write.xlsx(var_info, file.path(out_dir, "02_variable_info.xlsx"), overwrite = TRUE)
# ---------- 3) Primeras observaciones ----------
write.csv(head(df, 30), file.path(out_dir, "03_head_30.csv"), row.names = FALSE)
rows_with_na <- df[rowSums(is.na(df)) > 0, ]
write.csv(head(rows_with_na, 50), file.path(out_dir, "04_rows_with_na_sample.csv"), row.names = FALSE)
# ---------- 3) Primeras observaciones ----------
write.xlsx(head(df, 30), file.path(out_dir, "03_head_30.xlsx"), row.names = FALSE)
rows_with_na <- df[rowSums(is.na(df)) > 0, ]
write.xlsx(head(rows_with_na, 50), file.path(out_dir, "04_rows_with_na_sample.xlsx"), row.names = FALSE)
# ---------- 3) Primeras observaciones ----------
write.xlsx(head(df, 30), file.path(out_dir, "03_head_30.xlsx"), rowNames = FALSE)
rows_with_na <- df[rowSums(is.na(df)) > 0, ]
write.xlsx(head(rows_with_na, 50), file.path(out_dir, "04_rows_with_na_sample.xlsx"), row.names = FALSE)
write.xlsx(head(rows_with_na, 50), file.path(out_dir, "04_rows_with_na_sample.xlsx"), rowNames = FALSE)
# ---------- 4) Resúmenes numéricos ----------
num_vars <- df %>% select(where(is.numeric))
View(num_vars)
if(ncol(num_vars) > 0) {
summarise(across(everything(), list(
mediana = ~median(.x, na.rm = TRUE),
sd = ~sd(.x, na.rm = TRUE),
min = ~min(.x, na.rm = TRUE),
missing = ~sum(is.na(.x)),
))) %>%
View(num_vars)
View(num_vars)
# ---------- 4) Resúmenes numéricos ----------
num_vars <- df %>% select(where(is.numeric))
if(ncol(num_vars) > 0) {
desc_num <- num_vars %>%
summarise(across(everything(), list(
media = ~mean(.x, na.rm = TRUE),
mediana = ~median(.x, na.rm = TRUE),
moda = ~moda(.x),
sd = ~sd(.x, na.rm = TRUE),
IQR = ~IQR(.x, na.rm = TRUE),
min = ~min(.x, na.rm = TRUE),
max = ~max(.x, na.rm = TRUE),
missing = ~sum(is.na(.x)),
n = ~sum(!is.na(.x))
))) %>%
pivot_longer(everything(), names_to = c("variable","stat"), names_sep = "_", values_to = "value") %>%
pivot_wider(names_from = stat, values_from = value)
write.xlsx(desc_num, file.path(out_dir, "05_descriptivas_numericas.xlsx"), overwrite = TRUE)
}
# ---------- 5) Resúmenes categóricos ----------
cat_vars <- df %>% select(where(~!is.numeric(.)))
View(rows_with_na)
# ---------- 5) Resúmenes categóricos ----------
cat_vars <- df %>% select(where(~!is.numeric(.)))
if(ncol(cat_vars) > 0) {
cat_summary <- map_dfr(names(cat_vars), function(v) {
x <- cat_vars[[v]]
tb <- as.data.frame(table(x, useNA = "ifany"), stringsAsFactors = FALSE)
names(tb) <- c("level","count")
top_levels <- head(tb[order(-tb$count), ], 5)
tibble(
variable = v,
n_levels = n_distinct(x),
top1 = top_levels$level[1], top1_count = top_levels$count[1],
top2 = ifelse(nrow(top_levels)>=2, top_levels$level[2], NA),
top2_count = ifelse(nrow(top_levels)>=2, top_levels$count[2], NA),
top3 = ifelse(nrow(top_levels)>=3, top_levels$level[3], NA),
top3_count = ifelse(nrow(top_levels)>=3, top_levels$count[3], NA)
)
})
write.xlsx(cat_summary, file.path(out_dir, "06_descriptivas_categoricas.xlsx"), overwrite = TRUE)
}
