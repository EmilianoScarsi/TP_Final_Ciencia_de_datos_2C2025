hjust = 0
) +
scale_color_manual(values = c(
"Argentina" = "#1f4e79",
"Otros" = "grey70"
)) +
labs(
subtitle = "Comparación entre países seleccionados.",
x = "% del gasto empresarial",
y = NULL
) +
theme_minimal(base_size = 13) +
theme(
plot.background   = element_rect(fill = "white", color = NA),
panel.background  = element_rect(fill = "white", color = NA),
panel.grid        = element_blank(),   # quito todo el grid
axis.text.y = element_text(
colour = df$color_label[rank(df$valor_2021)],
size = 12
),
axis.text.x = element_text(size = 11),
plot.title = element_text(
face = "bold", size = 18, hjust = 0.5
),
plot.subtitle = element_text(
size = 13, hjust = 0.5
),
plot.caption = element_text(
size = 10, hjust = 0.5
),
legend.position = "none"
)
plot_lollipop
# Cargar mapa
world <- ne_countries(scale = "medium", returnclass = "sf")
# Renombrar países del DF
df_map <- df %>%
mutate(admin = case_when(
pais == "Corea del Sur"      ~ "South Korea",
pais == "Taiwán"             ~ "Taiwan",
pais == "Japón"              ~ "Japan",
pais == "Alemania"           ~ "Germany",
pais == "Italia"             ~ "Italy",
pais == "Estados Unidos"     ~ "United States of America",
pais == "España"             ~ "Spain",
pais == "Irlanda"            ~ "Ireland",
pais == "Noruega"            ~ "Norway",
pais == "Reino Unido"        ~ "United Kingdom",
TRUE ~ pais
))
# Merge
world_data <- left_join(world, df_map, by = "admin")
# Países a etiquetar (nombres EXACTOS del mapa)
paises_label <- c(
"United States of America",
"China",
"Germany",
"Japan",
"South Korea",
"Taiwan",
"Italy",
"Spain",
"Australia",
"Argentina"
)
labels_df <- world_data %>% filter(admin %in% paises_label)
# Coordenadas
labels_df <- labels_df %>%
mutate(centroid = st_centroid(geometry)) %>%
mutate(
Longitud = st_coordinates(centroid)[,1],
Latitud = st_coordinates(centroid)[,2]
)
# Plot
plot_mapa <- ggplot(world_data) +
geom_sf(aes(fill = valor_2021), color = "white", size = 0.15) +
scale_fill_viridis(
option = "C",
direction = 1,
na.value = "grey85",
name = ""
) +
geom_text(
data = labels_df,
aes(x = Longitud, y = Latitud, label = admin),
size = 3,
fontface = "bold",
color = "black"
) +
labs(
subtitle = "Peso del sector privado en la I+D — Año 2021"
) +
theme_minimal(base_size = 12) +
theme(
plot.subtitle = element_text(size = 12, hjust = 0.5),
legend.position = "bottom",
legend.key.width = unit(1.8, "cm"),
panel.grid = element_blank()
) +
coord_sf(
xlim = c(-160, 150),
ylim = c(-60, 80)
)
plot_mapa
final_plot <-
plot_lollipop + plot_mapa +
plot_annotation(
title = "Industria manufacturera e I+D empresarial — Panorama internacional (2021)",
subtitle = "Ranking y Distribución geográfica",
caption = "Fuente: OCDE • Elaboración propia",
theme = theme(
plot.title = element_text(size = 18, face = "bold", hjust = 0.5),
plot.subtitle = element_text(size = 13, hjust = 0.5),
plot.caption = element_text(size = 10, hjust = 0.5)
)
)
final_plot
ggsave(
filename = "Grupo_36.jpeg",
plot = plot_mapa,
width = 10,
height = 6,
dpi = 300
)
