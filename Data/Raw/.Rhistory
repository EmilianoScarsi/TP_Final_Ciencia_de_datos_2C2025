library(dplyr)
library(ggplot2)
library(sf)
library(rnaturalearth)
library(rnaturalearthdata)
library(patchwork)
df <- data.frame(
pais = c("Taiwán", "Corea del Sur", "Japón", "Alemania", "China", "Italia", "Estados Unidos", "Argentina", "España", "Irlanda", "Noruega", "Australia", "Reino Unido"),
valor_2021 = c(92.4, 86.1, 85.8, 82.7, 78.7, 69.4, 54.5, 49.7, 44.2, 38.9, 26.9, 25.4, 19.5)
)
df$es_argentina <- ifelse(df$pais == "Argentina", "Argentina", "Otros")
df$color_label <- ifelse(df$pais == "Argentina", "#1f4e79", "grey20")
plot_lollipop <- ggplot(df, aes(
x = valor_2021,
y = reorder(pais, valor_2021)
)) +
# Líneas horizontales de referencia (25, 50, 75)
geom_vline(xintercept = c(25, 50, 75),
color = "grey85", size = 0.3) +
# Línea horizontal (candle)
geom_segment(
aes(x = 0, xend = valor_2021,
y = reorder(pais, valor_2021),
yend = reorder(pais, valor_2021),
color = es_argentina),
size = 2
) +
# Punto al final
geom_point(
aes(color = es_argentina),
size = 5
) +
# Porcentajes al final de cada barra
geom_text(
aes(
label = paste0(valor_2021, "%"),
x = valor_2021 + 2,
y = reorder(pais, valor_2021),
color = es_argentina
),
size = 3,
hjust = 0
) +
scale_color_manual(values = c(
"Argentina" = "#1f4e79",
"Otros" = "grey70"
)) +
labs(
subtitle = "Comparación entre países seleccionados.",
x = "% del gasto empresarial",
y = NULL
) +
theme_minimal(base_size = 13) +
theme(
plot.background   = element_rect(fill = "white", color = NA),
panel.background  = element_rect(fill = "white", color = NA),
panel.grid        = element_blank(),   # quito todo el grid
axis.text.y = element_text(
colour = df$color_label[rank(df$valor_2021)],
size = 12
),
axis.text.x = element_text(size = 11),
plot.title = element_text(
face = "bold", size = 18, hjust = 0.5
),
plot.subtitle = element_text(
size = 13, hjust = 0.5
),
plot.caption = element_text(
size = 10, hjust = 0.5
),
legend.position = "none"
)
plot_lollipop
# Cargar mapa
world <- ne_countries(scale = "medium", returnclass = "sf")
# Renombrar países del DF
df_map <- df %>%
mutate(admin = case_when(
pais == "Corea del Sur"      ~ "South Korea",
pais == "Taiwán"             ~ "Taiwan",
pais == "Japón"              ~ "Japan",
